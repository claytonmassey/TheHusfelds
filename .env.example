# Standard database — Prisma Postgres catalog of captures and files.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/thehusfelds?sslmode=require"

# Vercel Blob — create this with the Vercel project, then run npm run import:blob.
BLOB_READ_WRITE_TOKEN=""

# Vector database — filled from Blob by npm run ingest:vectors.
VECTOR_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/thehusfelds_vectors?sslmode=require"

# Folder of originals. Stays on this machine. Relative to the project root, or absolute.
SOURCE_DIR="Source"
