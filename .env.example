# Standard database. Use the pooled Prisma Postgres URL in the app.
DATABASE_URL="postgres://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require"
# Direct Prisma Postgres URL, used by prisma db push.
DIRECT_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"

# Vercel Blob read-write token from the project's Blob store.
BLOB_READ_WRITE_TOKEN=""

# Upstash Vector. Vercel prefixes these with the integration name.
HUSFELDS_VECTOR_UPSTASH_VECTOR_REST_URL="https://example.upstash.io"
HUSFELDS_VECTOR_UPSTASH_VECTOR_REST_TOKEN=""
HUSFELDS_VECTOR_UPSTASH_VECTOR_REST_READONLY_TOKEN=""
OPENAI_API_KEY=""

# Folder of originals. Stays on this machine.
SOURCE_DIR="Source"
